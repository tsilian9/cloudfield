apiVersion: apps/v1
kind: Deployment
metadata:
  name: nodered
spec:
  replicas: 1
  selector:
    matchLabels:
      app: nodered
  template:
    metadata:
      labels:
        app: nodered
    spec:
      containers:
      - name: nodered
        image: nodered/node-red:latest
        ports:
        - containerPort: 1880
        # --- Προσθήκη Μεταβλητών από ConfigMap & Secret ---
        env:
        - name: RABBIT_HOST
          valueFrom:
            configMapKeyRef:
              name: farm-settings
              key: RABBITMQ_HOST
        - name: RABBIT_PORT
          valueFrom:
            configMapKeyRef:
              name: farm-settings
              key: RABBITMQ_PORT
        - name: RABBIT_USER
          valueFrom:
            secretKeyRef:
              name: farm-secrets
              key: RABBITMQ_USER
        - name: RABBIT_PASS
          valueFrom:
            secretKeyRef:
              name: farm-secrets
              key: RABBITMQ_PASS
        # --- Προσθήκη Volume Mount για μόνιμη αποθήκευση ---
        volumeMounts:
        - mountPath: /data
          name: nodered-data
      # --- Ορισμός του Volume στο Pod ---
      volumes:
      - name: nodered-data
        persistentVolumeClaim:
          claimName: nodered-pvc
---
# --- Δημιουργία του Persistent Volume Claim ---
apiVersion: v1
kind: PersistentVolumeClaim
metadata:
  name: nodered-pvc
spec:
  accessModes:
    - ReadWriteOnce
  resources:
    requests:
      storage: 1Gi
---
apiVersion: v1
kind: Service
metadata:
  name: nodered
spec:
  # Αφαιρέθηκε το type: NodePort
  selector:
    app: nodered
  ports:
    - name: nodered
      port: 1880
      targetPort: 1880
      # Αφαιρέθηκε το nodePort: 30180
---
# --- Ο Νέος Ingress με το nip.io ---
apiVersion: networking.k8s.io/v1
kind: Ingress
metadata:
  name: nodered-ingress
spec:
  rules:
  - host: nodered.172.31.76.79.nip.io  
    http:
      paths:
      - path: /
        pathType: Prefix
        backend:
          service:
            name: nodered
            port: 
              number: 1880