# ═══════════════════════════════════════════════════════════════
# Custom Jenkins Image with Docker CLI (COPY from local binary)
# Docker Hub: tsilian9/cloudfield-jenkins:latest
# 
# BEFORE the build, download the docker binary:
#   curl -fsSL https://download.docker.com/linux/static/stable/x86_64/docker-27.3.1.tgz \
#     | tar xz --strip-components=1 docker/docker
# ═══════════════════════════════════════════════════════════════
FROM jenkins/jenkins:lts-jdk17

USER root

# Copy the Docker CLI binary from the local folder
COPY docker /usr/local/bin/docker
RUN chmod +x /usr/local/bin/docker

# Return to the jenkins user
USER jenkins
