{
  "__inputs": [],
  "__requires": [],
  "annotations": {
    "list": []
  },
  "description": "CloudField IoT Platform – RabbitMQ Queue Depth & Telemetry Rate",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "id": 10,
      "title": "🐇 RabbitMQ Metrics",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "fftvih8df52psd" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 5 },
              { "color": "red", "value": 10 }
            ]
          },
          "unit": "short",
          "mappings": []
        }
      },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 1 },
      "id": 1,
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "background",
        "graphMode": "area",
        "justifyMode": "auto"
      },
      "title": "Queue Depth – valve.commands",
      "type": "stat",
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "fftvih8df52psd" },
          "expr": "rabbitmq_queue_messages{queue=\"valve.commands\"}",
          "legendFormat": "valve.commands depth",
          "refId": "A"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "fftvih8df52psd" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "unit": "short"
        }
      },
      "gridPos": { "h": 8, "w": 16, "x": 8, "y": 1 },
      "id": 2,
      "options": {
        "tooltip": { "mode": "single" },
        "legend": { "displayMode": "list", "placement": "bottom" }
      },
      "title": "Queue Depth Over Time – valve.commands",
      "type": "timeseries",
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "fftvih8df52psd" },
          "expr": "rabbitmq_queue_messages{queue=\"valve.commands\"}",
          "legendFormat": "Messages in queue",
          "refId": "A"
        },
        {
          "datasource": { "type": "prometheus", "uid": "fftvih8df52psd" },
          "expr": "rabbitmq_queue_messages_ready{queue=\"valve.commands\"}",
          "legendFormat": "Ready",
          "refId": "B"
        },
        {
          "datasource": { "type": "prometheus", "uid": "fftvih8df52psd" },
          "expr": "rabbitmq_queue_messages_unacknowledged{queue=\"valve.commands\"}",
          "legendFormat": "Unacknowledged",
          "refId": "C"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "fftvih8df52psd" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "unit": "short"
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 9 },
      "id": 3,
      "title": "RabbitMQ Message Rate (publish/deliver)",
      "type": "timeseries",
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "fftvih8df52psd" },
          "expr": "rate(rabbitmq_queue_messages_published_total{queue=\"valve.commands\"}[1m])",
          "legendFormat": "Publish rate",
          "refId": "A"
        },
        {
          "datasource": { "type": "prometheus", "uid": "fftvih8df52psd" },
          "expr": "rate(rabbitmq_queue_messages_delivered_total{queue=\"valve.commands\"}[1m])",
          "legendFormat": "Deliver rate",
          "refId": "B"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "fftvih8df52psd" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 3 },
              { "color": "red", "value": 5 }
            ]
          },
          "unit": "short"
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 9 },
      "id": 4,
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "background"
      },
      "title": "RabbitMQ Connections",
      "type": "stat",
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "fftvih8df52psd" },
          "expr": "rabbitmq_connections",
          "legendFormat": "Connections",
          "refId": "A"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 17 },
      "id": 11,
      "title": "📡 Telemetry Rate (Node-RED)",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "fftvih8df52psd" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "unit": "reqps"
        }
      },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 18 },
      "id": 5,
      "title": "Telemetry Rate – Messages/min (via RabbitMQ publish rate)",
      "type": "timeseries",
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "fftvih8df52psd" },
          "expr": "rate(rabbitmq_queue_messages_published_total[1m]) * 60",
          "legendFormat": "{{queue}} msgs/min",
          "refId": "A"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 26 },
      "id": 12,
      "title": "🖥️ Kubernetes Resources",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "fftvih8df52psd" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "unit": "percentunit"
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 27 },
      "id": 6,
      "title": "CPU Usage – CloudField Pods",
      "type": "timeseries",
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "fftvih8df52psd" },
          "expr": "rate(container_cpu_usage_seconds_total{namespace=\"default\", container!=\"\"}[1m])",
          "legendFormat": "{{pod}}",
          "refId": "A"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "fftvih8df52psd" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "unit": "bytes"
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 27 },
      "id": 7,
      "title": "Memory Usage – CloudField Pods",
      "type": "timeseries",
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "fftvih8df52psd" },
          "expr": "container_memory_working_set_bytes{namespace=\"default\", container!=\"\"}",
          "legendFormat": "{{pod}}",
          "refId": "A"
        }
      ]
    }
  ],
  "refresh": "30s",
  "schemaVersion": 38,
  "tags": ["cloudfield", "iot", "rabbitmq", "monitoring"],
  "templating": { "list": [] },
  "time": { "from": "now-1h", "to": "now" },
  "timepicker": {},
  "timezone": "browser",
  "title": "CloudField IoT Dashboard",
  "uid": "cloudfield-iot-v1",
  "version": 1
}
